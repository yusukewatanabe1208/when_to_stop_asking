# Copy this file to .env and fill in the keys for the providers you will call.
# .env is git-ignored; never commit real keys.
#
#   cp .env.example .env
#   python code/run_benchmark.py --model gpt-5.5 --reasoning high --out my_results.csv

# OpenAI models (gpt-*, o1, o3, o4)
OPENAI_API_KEY=

# Anthropic models (claude-*)
ANTHROPIC_API_KEY=

# Everything else goes through OpenRouter (qwen/*, google/*, meta-llama/*, ...)
OPENROUTER_API_KEY=
